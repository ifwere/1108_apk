<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical">

    <!-- Upper half: display only. It shows the recommendation result and nothing else. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-90dp"
            android:layout_marginEnd="-70dp"
            android:background="@drawable/bg_glow_indigo" />

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-80dp"
            android:layout_marginBottom="-70dp"
            android:background="@drawable/bg_glow_blue" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="20dp"
                android:paddingEnd="26dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:textColor="@color/white_55"
                    android:textSize="13sp"
                    tools:text="北京时间 · 11月8日 周日 10:00 · 周末" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_reco_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/deepseek"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="DS" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_suggest_label"
                            android:textColor="@color/white_55"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTarget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            tools:text="DeepSeek" />

                        <TextView
                            android:id="@+id/tvRuleHit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white_55"
                            android:textSize="13sp"
                            tools:text="命中规则 · 其余时间" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Lower half: countdown + one big tap target.
         Tapping anywhere here stops the timer and opens settings. -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel_bottom_ripple"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal">

            <com.aichoice.assistant.ui.CountdownRingView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_seconds_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvCountdownHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="5 秒后自动退出应用" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/main_stop_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/main_bottom_tap_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
