<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="54dp"
    android:layout_margin="2dp"
    android:background="@drawable/bg_calendar_cell">

    <View
        android:id="@+id/viewTodayRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_cell_today"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="17" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/calendar_holiday_text"
        android:textSize="9sp"
        tools:text="国庆" />

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="16dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_calendar_badge"
        android:gravity="center"
        android:text="@string/calendar_legend_makeup"
        android:textColor="@color/calendar_makeup_text"
        android:textSize="9sp"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
